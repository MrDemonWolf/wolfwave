{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build && node -e \"const fs=require('fs');for(const n of ['opengraph-image','twitter-image']){const s='out/'+n,d=s+'.png';if(fs.existsSync(s))fs.copyFileSync(s,d)}\"",
    "dev": "NEXT_PUBLIC_BASE_PATH='' next dev",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "test": "bun test"
  },
  "dependencies": {
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "serve": "^14.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "eslint-config-next": "16.4.0",
    "eslint": "^10.12.0"
  }
}