{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "WolfWave",
  "Version": "1.0.0.0",
  "Author": "MrDemonWolf, Inc.",
  "Description": "Control WolfWave from your Stream Deck. Play/pause, skip, manage the song-request queue, announce the song, block a requester, and toggle your overlay.",
  "Category": "WolfWave",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "URL": "https://wolfwave.mrdemonwolf.dev/",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "26"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/connection.html",
  "UUID": "com.mrdemonwolf.wolfwave",
  "Actions": [
    {
      "Name": "Play / Pause",
      "DisableAutomaticStates": true,
      "UUID": "com.mrdemonwolf.wolfwave.playpause",
      "Icon": "imgs/actions/playpause/icon",
      "Tooltip": "Play or pause Apple Music. The icon follows the real playback state.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/playpause/key-paused",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/playpause/key-playing",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Next Track",
      "UUID": "com.mrdemonwolf.wolfwave.skip",
      "Icon": "imgs/actions/skip/icon",
      "Tooltip": "Skip Apple Music to the next track. Does not send a Twitch chat message.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/skip/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Hold / Resume Queue",
      "DisableAutomaticStates": true,
      "UUID": "com.mrdemonwolf.wolfwave.queuehold",
      "Icon": "imgs/actions/queuehold/icon",
      "Tooltip": "Hold or resume the song-request queue without pausing the current song. Shows the queue size.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/queuehold/key-running",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/queuehold/key-held",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Approve Next",
      "DisableAutomaticStates": true,
      "UUID": "com.mrdemonwolf.wolfwave.approvenext",
      "Icon": "imgs/actions/approvenext/icon",
      "Tooltip": "Approve the oldest request waiting for review. Shows the pending count; amber means requests need review.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/approvenext/key-empty",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/approvenext/key-pending",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Clear Queue",
      "UUID": "com.mrdemonwolf.wolfwave.clearqueue",
      "Icon": "imgs/actions/clearqueue/icon",
      "Tooltip": "Hold for about a second to clear all requests and the WolfWave Requests playlist. Stops Music when requests exist; songs stay in your library.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/clearqueue/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Block Song",
      "UUID": "com.mrdemonwolf.wolfwave.blockcurrent",
      "Icon": "imgs/actions/blockcurrent/icon",
      "Tooltip": "Block future requests for the current song. Does not skip the song that is playing.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/blockcurrent/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Show / Hide Overlay",
      "DisableAutomaticStates": true,
      "UUID": "com.mrdemonwolf.wolfwave.overlaytoggle",
      "Icon": "imgs/actions/overlaytoggle/icon",
      "Tooltip": "Show or hide the stream overlay while keeping WolfWave and Stream Deck connected.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/overlaytoggle/key-off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/overlaytoggle/key-on",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Announce Song",
      "UUID": "com.mrdemonwolf.wolfwave.announcesong",
      "Icon": "imgs/actions/announcesong/icon",
      "Tooltip": "Post the current song to Twitch chat, using the same message as !song. Requires Twitch connected.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/announcesong/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Reject Request",
      "UUID": "com.mrdemonwolf.wolfwave.rejectcurrent",
      "Icon": "imgs/actions/rejectcurrent/icon",
      "Tooltip": "Remove the request that is playing and notify Twitch chat. Does not block the song or requester.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/rejectcurrent/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Block Requester",
      "UUID": "com.mrdemonwolf.wolfwave.blockrequester",
      "Icon": "imgs/actions/blockrequester/icon",
      "Tooltip": "Hold for about a second to block future requests from the person who requested the song that is playing.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/blockrequester/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Request Audience",
      "DisableAutomaticStates": true,
      "UUID": "com.mrdemonwolf.wolfwave.cycleaudience",
      "Icon": "imgs/actions/cycleaudience/icon",
      "Tooltip": "Cycle who may request: everyone, subscribers, VIPs and subscribers, then moderators. Shows the current audience.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/cycleaudience/key-open",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/cycleaudience/key-gated",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Track Time",
      "UUID": "com.mrdemonwolf.wolfwave.tracktime",
      "Icon": "imgs/actions/tracktime/icon",
      "Tooltip": "Show elapsed or remaining time and track progress. Press to switch; the choice is saved for this key.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/tracktime/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Now Playing",
      "DisableAutomaticStates": true,
      "UUID": "com.mrdemonwolf.wolfwave.nowplaying",
      "Icon": "imgs/actions/nowplaying/icon",
      "Tooltip": "Show the current song and artist over album artwork, with a pause indicator. Display only; pressing does nothing.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/nowplaying/key-paused",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/nowplaying/key-playing",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}