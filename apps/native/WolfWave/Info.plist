<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>WolfWave reads your currently playing track and, when Song Requests are enabled, creates and updates a WolfWave Requests playlist in your Apple Music library so approved viewer requests can play.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>WolfWave uses Apple Events to read Now Playing information and, when you use Song Requests or playback controls, play approved requests, skip tracks, and control Apple Music playback.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>WolfWave runs a local WebSocket and HTTP server on your Mac to stream now-playing data to OBS browser source overlays. No data is sent outside your local network.</string>
	<key>CFBundleDisplayName</key>
	<string>WolfWave</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 MrDemonWolf, Inc. All rights reserved.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.mrdemonwolf.wolfwave</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wolfwave</string>
			</array>
		</dict>
	</array>
	<key>SUFeedURL</key>
	<string>https://github.com/MrDemonWolf/wolfwave/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>Ccoxj8YsfvYlbNDi0/LnwFY/Wa3aBU+tlJX5cqjt3X8=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>TWITCH_CLIENT_ID</key>
	<string>$(TWITCH_CLIENT_ID)</string>
	<key>DISCORD_CLIENT_ID</key>
	<string>$(DISCORD_CLIENT_ID)</string>
	<key>GITHUB_REPO_OWNER</key>
	<string>$(GITHUB_REPO_OWNER)</string>
	<key>GITHUB_REPO_NAME</key>
	<string>$(GITHUB_REPO_NAME)</string>
	<key>DOCS_URL</key>
	<string>$(DOCS_URL)</string>
	<key>COMMUNITY_DISCORD_URL</key>
	<string>$(COMMUNITY_DISCORD_URL)</string>
	<key>COPYRIGHT_HOLDER</key>
	<string>$(COPYRIGHT_HOLDER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
