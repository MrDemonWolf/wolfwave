{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#tokens": {
      "inputs": [
        "design-system/tokens.json",
        "design-system/scripts/generate.ts"
      ],
      "outputs": [
        "apps/native/WolfWave/Core/DesignSystem/Tokens.generated.swift",
        "apps/docs/app/tokens.generated.css",
        "apps/native/WolfWave/Resources/widget-tokens.generated.js",
        "apps/marketing/shared/tokens.generated.ts",
        "apps/docs/app/*/_widgets/widget-themes.generated.ts"
      ]
    },
    "//#ds:lint": {
      "inputs": [
        "apps/native/WolfWave/Views/**/*.swift",
        "design-system/scripts/lint.ts",
        "design-system/lint-allowlist.txt"
      ]
    },
    "build": {
      "dependsOn": ["^build", "//#tokens", "widget#build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".source/**", "out/**"]
    },
    "widget#build": {
      "dependsOn": ["//#tokens"],
      "inputs": [
        "src/**",
        "tailwind.config.ts",
        "postcss.config.js",
        "build.ts",
        "package.json",
        "$TURBO_ROOT$/design-system/tokens.json",
        "$TURBO_ROOT$/apps/native/WolfWave/Resources/widget-tokens.generated.js"
      ],
      "outputs": [
        "dist/**",
        "$TURBO_ROOT$/apps/native/WolfWave/Resources/widget.html"
      ]
    },
    "streamdeck#build": {
      "inputs": [
        "apps/streamdeck/src/**",
        "apps/streamdeck/build.ts",
        "apps/streamdeck/package.json",
        "apps/streamdeck/com.mrdemonwolf.wolfwave.sdPlugin/manifest.json"
      ],
      "outputs": ["apps/streamdeck/com.mrdemonwolf.wolfwave.sdPlugin/bin/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#tokens"]
    },
    "clean": {
      "cache": false
    }
  }
}
